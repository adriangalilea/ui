  "composition": {
    "md": "picture: resolution text + range lockup ('4K' + Dolby Vision lockup; '4K' + HDR10 badge; '1080p' alone). sound: object lockup if any (Dolby Atmos lockup) + codec/channels text ('TrueHD 7.1'); else codec lockup + channels text ('DTS-HD MA' lockup + '5.1'); codecs without a lockup = text. tier: mark alone for bluray/dvd; mark + 'Remux'. lang: flag + 'castellano'. cut: IMAX mark alone.",
    "sm": "picture: symbol + short text (Dolby D + 'DV'; HDR10+ badge alone; '4K' text alone). sound: symbol + short (Dolby D + 'Atmos'; dts symbol + 'X'). tier: symbol alone. lang: flag alone. cut: IMAX mark alone."
  }
